  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AIDoctorChatPanel
  questionPanel: {fileID: 388026083}
  responsePanel: {fileID: 931723606}
  promptInput: {fileID: 1425885044}
  questionOutput: {fileID: 2003086477}
  responseOutput: {fileID: 384324316}
  statusLabel: {fileID: 569917318}
